# For `docker compose up` — copy to .env in this same directory (Compose
# reads it automatically for the ${VAR} substitutions in docker-compose.yml).
# Everything here is optional; sensible defaults are baked into the compose
# file itself. See apps/api/.env.example for the full list of API env vars
# (relevant here too, forwarded straight through to the api container).

JWT_SECRET=change-me-in-production
WEB_ORIGIN=http://localhost:8080

ANTHROPIC_API_KEY=
AI_MODEL=
AI_MODEL_CUSTOMER=
AI_MODEL_COACH=
AI_MODEL_JUDGMENT=
AI_MODEL_TRAINER=
