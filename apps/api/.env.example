# Copy to .env and fill in as needed. Every AI_* var is optional — leave
# ANTHROPIC_API_KEY/AI_MODEL unset and every AI call falls back to rule-based
# logic (see CLAUDE.md "Engineering rules").

DATABASE_URL="file:./dev.db"
JWT_SECRET=change-me-in-production
WEB_ORIGIN=http://localhost:5173
PORT=4000

# --- AI (optional) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
# Per-role overrides (CLAUDE.md: "Model name lives in config, never hard-coded
# in logic"). Each falls back to AI_MODEL when unset. Route cheap/frequent
# calls (stage detection, judgment scoring) to a lighter model for cost
# control while keeping a stronger one for the customer persona the learner
# actually talks to.
# AI_MODEL_CUSTOMER=claude-sonnet-5
# AI_MODEL_COACH=claude-haiku-5-5
# AI_MODEL_JUDGMENT=claude-haiku-5-5
# AI_MODEL_TRAINER=claude-sonnet-5
# Per-call timeout before falling back (ms).
AI_CALL_TIMEOUT_MS=15000

# --- Scripted-replay timing (CLAUDE.md: realistic by default) ---
# SCRIPTED_CHARS_PER_SEC=14
# SCRIPTED_THINK_MS=500
# RINGING_DELAY_MIN_MS=2000
# RINGING_DELAY_MAX_MS=3000
# Floor between learner turns (ms); must stay below the 500ms autoplay delay.
# MIN_LEARNER_TURN_INTERVAL_MS=300

# GUIDED-mode verbatim-reading penalty cap (points).
# GUIDED_VERBATIM_PENALTY_MAX=10
