# Copy to .env in this folder. Every var is optional; the dashboard falls
# back to a clear "not connected" state per panel until a value is set.

PORT=4100
WEB_ORIGIN=http://localhost:5180

# --- Git / GitHub (Code Contribution & Reviews, Recent Activity) ---
# Defaults to this monorepo's own checkout and its `origin` remote. Only
# set these if the dashboard should read a different repo.
# GIT_REPO_PATH=../..
# GITHUB_REPO=owner/name
#
# Token used to call the GitHub REST API (commits, PRs, reviews). Needs
# `repo` scope for a private repo, `public_repo` for a public one. If unset,
# falls back to `gh auth token` (the GitHub CLI's own stored token) when the
# `gh` CLI is installed and logged in on this machine.
# GITHUB_TOKEN=

# --- Claude usage & cost (AI Usage & Cost panel) ---
# An Admin API key from console.anthropic.com -> Settings -> Admin API keys
# (role: Admin; needs the Usage & Cost Reporting scope). This is an
# organization-level secret: keep it in this .env only, never in the browser
# or in git. Leave unset and the panel shows "Not connected".
# ANTHROPIC_ADMIN_API_KEY=

# --- Jira / Confluence ---
# These can also be set and tested from the dashboard's Settings screen
# (Integrations), which stores them in apps/dev-dashboard-api/.data/
# (gitignored, local to this machine) instead of here. Env vars below are
# just an alternative way to provision them, e.g. for a shared deployment.
# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=
# CONFLUENCE_BASE_URL=https://your-domain.atlassian.net
# CONFLUENCE_EMAIL=you@example.com
# CONFLUENCE_API_TOKEN=
